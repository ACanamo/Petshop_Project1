# Copy this file to .env.local (or .env) and fill in your own Supabase
# project's values to point this app at a different backend (e.g. staging)
# instead of the one hardcoded as the default in src/lib/supabase.js.
#
# Both are the public "anon"/"publishable" key and project URL — safe to
# expose in client code, protected by Row Level Security, NOT secrets.
# Never put a service-role key here or anywhere in this app's client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
